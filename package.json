{
  "name": "lyrical-inventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:backend": "node backend/server.js",
    "dev:all": "sh -c \"npm run dev:backend & npm run dev\"",
    "lint": "eslint src --ext .js",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/phone-shots/capture.mjs"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright-core": "1.64.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
